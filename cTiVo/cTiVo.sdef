<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="cTiVo Terminology" xmlns:xi="http://www.w3.org/2003/XInclude">

	<xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>

	<suite name="cTiVo Suite" code="cTiV" description="Classes and commands for controlling cTiVo.">

		<class-extension extends="application" description="cTiVo's application object.">
			<cocoa class="NSApplication"/>
			<element type="tivo" access="r">
				<cocoa key="tivos"/>
			</element>
			<element type="show" access="r" description="All recordings across all TiVos.">
				<cocoa key="tivoShows"/>
			</element>
			<element type="download" access="r" description="Convenience: same as downloads of queue.">
				<cocoa key="downloadQueue"/>
			</element>
			<element type="format" access="r" description="The conversion formats cTiVo can use.">
				<cocoa key="formatList"/>
			</element>
			<property name="download queue" code="cTQp" type="queue" access="r" description="cTiVo's download queue.">
				<cocoa key="downloadQueueObject"/>
			</property>
			<property name="selected format" code="cTSF" type="format" access="r" description="The format currently selected as the default for new downloads.">
				<cocoa key="selectedFormat"/>
			</property>
			<property name="processing paused" code="cTPP" type="boolean" access="rw" description="True when cTiVo's download queue processing is paused. Set to true to pause; set to false to resume.">
				<cocoa key="processingPaused"/>
			</property>
			<responds-to command="pause processing">
				<cocoa method="handlePauseProcessingCommand:"/>
			</responds-to>
			<responds-to command="resume processing">
				<cocoa method="handleResumeProcessingCommand:"/>
			</responds-to>
			<responds-to command="add">
				<cocoa method="handleAddCommand:"/>
			</responds-to>
		</class-extension>

		<class name="tivo" code="cTVT" description="A TiVo device that cTiVo can communicate with.">
			<cocoa class="MTTiVo"/>
			<element type="show" access="r" description="Recordings on this TiVo.">
				<cocoa key="shows"/>
			</element>
			<property name="name" code="pnam" type="text" access="r" description="The display name of the TiVo. Uses the user-customized name if set in cTiVo, otherwise the Bonjour broadcast name."/>
			<property name="serial number" code="cTSN" type="text" access="r" description="The TiVo's serial number.">
				<cocoa key="tiVoSerialNumber"/>
			</property>
			<property name="mini" code="cTMn" type="boolean" access="r" description="True if this is a TiVo Mini, which has no local recording capability.">
				<cocoa key="isMini"/>
			</property>
			<property name="reachable" code="cTRc" type="boolean" access="r" description="Whether cTiVo can currently reach this TiVo on the network.">
				<cocoa key="isReachable"/>
			</property>
			<property name="supports transport stream" code="cTTS" type="boolean" access="r" description="Whether this TiVo can deliver recordings as MPEG-TS (required for H.264 channels).">
				<cocoa key="supportsTransportStream"/>
			</property>
			<property name="supports RPC" code="cTRP" type="boolean" access="r" description="Whether this TiVo supports the RPC protocol used for SkipMode, remote control, and other interactive features.">
				<cocoa key="supportsRPC"/>
			</property>
			<property name="enabled" code="cTen" type="boolean" access="r" description="Whether cTiVo is configured to communicate with this TiVo.">
				<cocoa key="enabled"/>
			</property>
			<property name="last download ended" code="cTLE" type="date" access="r" description="When cTiVo last finished downloading a recording from this TiVo.">
				<cocoa key="lastDownloadEnded"/>
			</property>
		</class>

		<class name="show" code="cTSh" description="A recording on a TiVo.">
			<cocoa class="MTTiVoShow"/>

			<property name="id" code="ID  " type="integer" access="r" description="The show's TiVo-assigned numeric ID. Unique within a single TiVo, not across TiVos.">
				<cocoa key="showID"/>
			</property>
			<property name="unique id" code="cSuI" type="text" access="r" description="A stable identifier that is unique across all TiVos. Combines the program ID with the show date for non-episodic recordings.">
				<cocoa key="uniqueID"/>
			</property>
			<property name="tivo" code="cSTv" type="tivo" access="r" description="The TiVo this recording is on.">
				<cocoa key="tiVo"/>
			</property>

			<property name="series title" code="cSST" type="text" access="r" description="The series title (e.g. &quot;The Bear&quot;).">
				<cocoa key="seriesTitle"/>
			</property>
			<property name="episode title" code="cSET" type="text" access="r" description="The title of this specific episode.">
				<cocoa key="episodeTitle"/>
			</property>
			<property name="description" code="cSDe" type="text" access="r" description="The synopsis or description of the recording.">
				<cocoa key="showDescription"/>
			</property>

			<property name="season" code="cSSn" type="integer" access="r" description="The season number, or 0 if unknown."/>
			<property name="episode" code="cSEp" type="integer" access="r" description="The episode number within the season, or 0 if unknown."/>
			<property name="season episode" code="cSSE" type="text" access="r" description="A combined &quot;S02E04&quot;-style season-and-episode identifier.">
				<cocoa key="seasonEpisode"/>
			</property>
			<property name="original air date" code="cSOA" type="text" access="r" description="The original broadcast date as supplied by TiVo. Kept as text because the format varies by source.">
				<cocoa key="originalAirDate"/>
			</property>

			<property name="movie" code="cSMo" type="boolean" access="r" description="True if the recording is a movie.">
				<cocoa key="isMovie"/>
			</property>
			<property name="episodic" code="cSEs" type="boolean" access="r" description="True if the recording is part of an episodic series (as opposed to a one-off, sports event, or movie).">
				<cocoa key="isEpisodicShow"/>
			</property>
			<property name="suggestion" code="cSSu" type="boolean" access="r" description="True if this recording was made automatically by TiVo Suggestions rather than requested by the user.">
				<cocoa key="isSuggestion"/>
			</property>
			<property name="queued" code="cSQu" type="boolean" access="r" description="True if this recording is currently in cTiVo's download queue.">
				<cocoa key="isQueued"/>
			</property>
			<property name="protected" code="cSPr" type="boolean" access="r" description="True if the recording is copy-protected (DRM) and cannot be downloaded.">
				<cocoa key="protectedShow"/>
			</property>
			<property name="in progress" code="cSIP" type="boolean" access="r" description="True if the TiVo is currently in the middle of recording this show.">
				<cocoa key="inProgress"/>
			</property>
			<property name="HD" code="cSHD" type="boolean" access="r" description="True if the recording is high-definition.">
				<cocoa key="isHD"/>
			</property>
			<property name="on disk" code="cSOD" type="boolean" access="r" description="True if cTiVo has already downloaded a copy of this recording to local disk.">
				<cocoa key="isOnDisk"/>
			</property>

			<property name="show date" code="cSDt" type="date" access="r" description="When the recording was made.">
				<cocoa key="showDate"/>
			</property>
			<property name="length" code="cSLe" type="integer" access="r" description="The length of the recording in seconds.">
				<cocoa key="showLength"/>
			</property>
			<property name="file size" code="cSFS" type="integer" access="r" description="The size of the recording on the TiVo, in bytes.">
				<cocoa key="fileSize"/>
			</property>

			<property name="channel" code="cSCh" type="text" access="r" description="The channel name (e.g. &quot;HBO&quot;).">
				<cocoa key="channelString"/>
			</property>
			<property name="channel number" code="cSCN" type="integer" access="r" description="The numeric channel number, or a large sentinel value if unknown.">
				<cocoa key="channelNumber"/>
			</property>
			<property name="station" code="cSSt" type="text" access="r" description="The broadcast station call sign (e.g. &quot;KOMO&quot;).">
				<cocoa key="stationCallsign"/>
			</property>

			<property name="age rating" code="cSAR" type="text" access="r" description="The age rating, combining TV and MPAA ratings (e.g. &quot;TV-MA&quot;, &quot;PG-13&quot;).">
				<cocoa key="ageRatingString"/>
			</property>
			<property name="star rating" code="cSSR" type="text" access="r" description="The critical star rating supplied by TiVo, as a formatted string.">
				<cocoa key="starRatingString"/>
			</property>
		</class>

		<class name="queue" code="cTQu" description="cTiVo's download queue. There is exactly one queue per running cTiVo instance.">
			<cocoa class="MTTiVoManager"/>
			<element type="download" access="r">
				<cocoa key="downloadQueue"/>
			</element>
		</class>

		<class name="download" code="cTDl" description="A queued or in-progress download in cTiVo.">
			<cocoa class="MTDownload"/>

			<property name="show" code="cDSh" type="show" access="r" description="The recording being downloaded."/>
			<property name="format" code="cDFm" type="format" access="r" description="The conversion format that will be used.">
				<cocoa key="encodeFormat"/>
			</property>
			<property name="status" code="cDSt" type="text" access="r" description="A human-readable description of the download's current state.">
				<cocoa key="showStatus"/>
			</property>
			<property name="progress" code="cDPg" type="real" access="r" description="Download progress as a fraction from 0.0 to 1.0.">
				<cocoa key="processProgress"/>
			</property>
			<property name="speed" code="cDSp" type="real" access="r" description="Current transfer speed in bytes per second."/>
			<property name="time left" code="cDTL" type="text" access="r" description="A human-readable estimate of remaining time.">
				<cocoa key="timeLeft"/>
			</property>

			<property name="downloading" code="cDDg" type="boolean" access="r" description="True if this download is actively transferring or processing.">
				<cocoa key="isDownloading"/>
			</property>
			<property name="done" code="cDDn" type="boolean" access="r" description="True if the download has finished.">
				<cocoa key="isDone"/>
			</property>
			<property name="canceled" code="cDCx" type="boolean" access="r" description="True if the download was canceled.">
				<cocoa key="isCanceled"/>
			</property>

			<property name="download directory" code="cDDr" type="text" access="r" description="The directory the file is being saved into.">
				<cocoa key="downloadDirectory"/>
			</property>
			<property name="output path" code="cDOP" type="text" access="r" description="The full path of the encoded output file (may not yet exist).">
				<cocoa key="encodeFilePath"/>
			</property>

			<property name="add to iTunes" code="cDAi" type="boolean" access="r" description="True if the encoded file will be added to TV/Music when complete.">
				<cocoa key="addToiTunesWhenEncoded"/>
			</property>
			<property name="skip commercials" code="cDSC" type="boolean" access="r" description="True if commercials will be cut from the output.">
				<cocoa key="skipCommercials"/>
			</property>
			<property name="mark commercials" code="cDMC" type="boolean" access="r" description="True if commercial boundaries will be marked in the output (rather than cut).">
				<cocoa key="markCommercials"/>
			</property>
			<property name="use skip mode" code="cDUS" type="boolean" access="r" description="True if TiVo's SkipMode data will be used to identify commercials.">
				<cocoa key="useSkipMode"/>
			</property>
		</class>

		<command name="pause processing" code="cTiVPaus" description="Pause cTiVo's download queue processing. New downloads will not start until processing is resumed."/>
		<command name="resume processing" code="cTiVResu" description="Resume cTiVo's download queue processing if it was paused."/>

		<command name="add" code="cTiVAdd " description="Add one or more shows to cTiVo's download queue. Uses the currently selected format and the user's default download options.">
			<direct-parameter description="The show or shows to add to the download queue.">
				<type type="show" list="yes"/>
			</direct-parameter>
			<result description="The download(s) that were created.">
				<type type="download" list="yes"/>
			</result>
		</command>

		<class name="format" code="cTFm" description="A video conversion format (e.g. &quot;Apple TV 4K&quot;, &quot;iPhone HD&quot;).">
			<cocoa class="MTFormat"/>

			<property name="name" code="pnam" type="text" access="r" description="The display name of the format."/>
			<property name="description" code="cFDe" type="text" access="r" description="A human-readable description of the format.">
				<cocoa key="formatDescription"/>
			</property>
			<property name="extension" code="cFEx" type="text" access="r" description="The output filename extension (e.g. &quot;mp4&quot;, &quot;m4v&quot;).">
				<cocoa key="filenameExtension"/>
			</property>
			<property name="encoder" code="cFEn" type="text" access="r" description="Which encoder this format uses (e.g. &quot;HandBrakeCLI&quot;, &quot;ffmpeg&quot;).">
				<cocoa key="encoderUsed"/>
			</property>

			<property name="available" code="cFAv" type="boolean" access="r" description="True if the encoder this format depends on is installed and ready.">
				<cocoa key="isAvailable"/>
			</property>
			<property name="hidden" code="cFHd" type="boolean" access="r" description="True if the user has hidden this format from the format picker.">
				<cocoa key="isHidden"/>
			</property>
			<property name="factory" code="cFFa" type="boolean" access="r" description="True if this is a built-in format supplied with cTiVo (rather than a user-customized one).">
				<cocoa key="isFactoryFormat"/>
			</property>
			<property name="deprecated" code="cFDp" type="boolean" access="r" description="True if this format is deprecated.">
				<cocoa key="isDeprecated"/>
			</property>
			<property name="commercial skip" code="cFCS" type="boolean" access="r" description="True if commercials will be cut when using this format.">
				<cocoa key="comSkip"/>
			</property>
			<property name="add to iTunes" code="cFAi" type="boolean" access="r" description="True if downloads using this format are automatically added to TV/Music when complete.">
				<cocoa key="iTunes"/>
			</property>
		</class>

	</suite>

</dictionary>
